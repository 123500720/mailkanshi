# ============================================================
# 公司邮件智能监控工具 — 配置文件
# 复制本文件为 .env 并填入实际值
# ============================================================

# ---- IMAP 邮箱配置：只连接公司邮箱服务器 ----
IMAP_SERVER=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=
IMAP_SSL=1
IMAP_FOLDER=INBOX
IMAP_SEARCH=ALL
IMAP_TIMEOUT=30

# Python 标准库版采用 UID 增量轻量轮询；要满足 10 秒验收就设为 10
POLL_INTERVAL=10
PREFER_IDLE=0

# ---- Ollama 本地 AI 配置：默认禁止远程地址 ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120
OLLAMA_NUM_THREAD=8
OLLAMA_NUM_CTX=2048
ALLOW_REMOTE_OLLAMA=0

# ---- AI 分析配置 ----
AI_BODY_MAX_LEN=3000
CATEGORIES=报价,客户咨询,新增任务,会议,报表,通知,垃圾邮件,其他

# ---- 规则引擎 ----
RULE_WHITELIST=
RULE_KEYWORDS=紧急,urgent,asap,加急,重要,important

# ---- 本地输出路径 ----
DB_PATH=mail_monitor.db
OUTPUT_MD=index.md
RESULTS_JSONL=results.jsonl
LOG_FILE=monitor.log
EXPORTS_DIR=exports
BODY_PREVIEW_LEN=200
MAX_RETRY=3
